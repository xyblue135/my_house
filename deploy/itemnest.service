[Unit]
Description=ItemNest family server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=itemnest
Group=itemnest
WorkingDirectory=/opt/itemnest
EnvironmentFile=/etc/itemnest/server.env
ExecStart=/usr/bin/java -jar /opt/itemnest/itemnest.jar
Restart=on-failure
RestartSec=5
StateDirectory=itemnest
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/itemnest

[Install]
WantedBy=multi-user.target
