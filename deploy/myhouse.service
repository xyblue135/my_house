[Unit]
Description=My House family server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=myhouse
Group=myhouse
WorkingDirectory=/opt/myhouse
EnvironmentFile=/etc/myhouse/server.env
ExecStart=/usr/bin/java -jar /opt/myhouse/myhouse.jar
Restart=on-failure
RestartSec=5
StateDirectory=myhouse
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/myhouse

[Install]
WantedBy=multi-user.target
