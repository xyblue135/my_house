# 数据目录（start.bat 未配置时默认使用项目根目录的 data；start.sh 固定使用该目录）
MYHOUSE_DATA_DIR=./data

# 默认仅监听本机。确实需要局域网访问时改为 0.0.0.0。
MYHOUSE_BIND_ADDRESS=127.0.0.1

# 外网部署必须开启，并设置至少 32 位随机密钥。支持旧名 MYHOUSE_LAN_TOKEN。
# .env 不会由 Java/启动脚本自动加载；需导出环境变量或使用 deploy/myhouse.service。
MYHOUSE_REQUIRE_AUTH=false
MYHOUSE_ACCESS_TOKEN=

# OpenAI 兼容接口。也支持 MYHOUSE_AI_BASE_URL / MYHOUSE_AI_API_KEY / MYHOUSE_AI_MODEL。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=auto

# RabbitMQ：SQLite 主功能不依赖 MQ，默认关闭；需要事件总线时再开启。
MYHOUSE_RABBITMQ_ENABLED=false
MYHOUSE_RABBITMQ_URL=amqp://guest:guest@127.0.0.1/
MYHOUSE_RABBITMQ_EXCHANGE=myhouse.events
MYHOUSE_RABBITMQ_QUEUE=myhouse.inventory.events
MYHOUSE_RABBITMQ_WORKER_ENABLED=false
